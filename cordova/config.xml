<?xml version='1.0' encoding='utf-8'?>
<widget id="cn.yuanhuan.game" version="1.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>元幻</name>
    <description>
        元幻 —— 3D 第三人称星球收·打·撤探索手游。在随机分配的未知星球上收集、战斗、捕捉与限时撤离。
    </description>
    <author email="dev@yuanhuan.cn" href="https://yuanhuan.cn">YuanHuan Studio</author>

    <content src="index.html" />

    <!-- 离线运行：游戏与 three.js 引擎全部内嵌于 www/index.html，无需网络 -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- 全局偏好 -->
    <preference name="BackgroundColor" value="0xff070b1a" />
    <preference name="Orientation" value="default" />
    <preference name="Fullscreen" value="true" />
    <preference name="KeepRunning" value="false" />
    <preference name="LoadUrlTimeoutValue" value="30000" />
    <preference name="ScrollEnabled" value="false" />

    <platform name="android">
        <icon src="res/icon.jpg" />
        <preference name="AndroidWindowSplashScreenBackground" value="#070b1a" />
        <preference name="Fullscreen" value="true" />
        <preference name="AndroidXEnabled" value="true" />
        <!-- 允许 http 远程调试: chrome://inspect -->
        <preference name="debuggable" value="true" />
    </platform>

  
</widget>
